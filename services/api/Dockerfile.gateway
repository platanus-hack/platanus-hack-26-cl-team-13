# Gateway del modelo de Gemelo para Render. Servicio aparte del orquestador: la key de
# Anthropic vive solo en este contenedor.
#   docker build -f services/api/Dockerfile.gateway -t gemelo-gateway .
FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /usr/local/bin/uv

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app/services/api
COPY services/api/pyproject.toml services/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY services/api/gemelo ./gemelo

ENV PATH="/app/services/api/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 10001 app
USER app

EXPOSE 8787
# --proxy-headers: Render termina TLS delante. Sin --access-log: la URL del upstream no
# pasa por aquí, pero así ninguna ruta con token queda en el log de acceso.
CMD ["sh", "-c", "uvicorn gemelo.gateway.app:app --host 0.0.0.0 --port ${PORT:-8787} --proxy-headers --no-access-log"]
