# Copiar a .env y completar. No commitear .env.
# Gateway del modelo (services/api/gemelo/gateway). Solo lo lee el gateway; nunca entra a una caja.
# Base del upstream: https://api.anthropic.com o el proxy de la hackatón con el token phk_ en la ruta.
GATEWAY_UPSTREAM_URL=https://api.anthropic.com
GATEWAY_UPSTREAM_API_KEY=
# Mismo valor que GEMELO_GATEWAY_ADMIN_TOKEN en el orquestador
GATEWAY_ADMIN_TOKEN=
GATEWAY_MODEL=claude-haiku-5-5
GATEWAY_DEFAULT_BUDGET_USD=2.5

# Proveedor de sandboxes: local (Docker) | e2b (microVMs en E2B). Por defecto: local.
SANDBOX_PROVIDER=local
# Key de E2B. Solo la usa el orquestador; nunca entra a un sandbox. Necesaria si SANDBOX_PROVIDER=e2b.
E2B_API_KEY=
